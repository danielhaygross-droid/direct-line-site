{
  "name": "direct-line-control",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-screens.mjs && node scripts/build-css.mjs && node scripts/build-worker.mjs",
    "build:screens": "node scripts/build-screens.mjs",
    "build:css": "node scripts/build-css.mjs",
    "test": "node scripts/build-screens.mjs --check && node scripts/build-css.mjs --check && node --test tests/*.test.mjs",
    "checks": "node scripts/run-checks.mjs",
    "checks:api": "node scripts/run-checks.mjs --api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "^2.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/cli": "4.3.3",
    "playwright-core": "1.62.1"
  }
}
